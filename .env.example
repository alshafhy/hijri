APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DIRECTION=rtl

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=muquem_v3
DB_USERNAME=root
DB_PASSWORD=

# Read-only legacy source (Phase 7 importers). Do not point writers here.
LEGACY_DB_HOST=
LEGACY_DB_PORT=
LEGACY_DB_DATABASE=muqaym
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_IMPORT_CHUNK=200
# Absolute path(s) to legacy images/requests dirs (comma-separated).
# Layout: {LEGACY_PICTURE_PATHS}/{legacy_request_id}/{filename}
# Re-check with: php artisan legacy:verify-pictures
LEGACY_PICTURE_PATHS=

# Local harness alternative (never commit real credentials):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"

IGNITION_EDITOR=vscode
DISABLE_ACL=true
SHOW_SUPER_ADMIN_MENU=false

# Comma-separated list of allowed IP addresses. Leave empty to allow all.
ALLOWED_IPS=

COMPANY_NAME=Muqayem
COMPANY_NAME_AR=
COMPANY_URL=
COMPANY_COPYRIGHT=
